@model OnlineShoppingAutomation.Models.Classes.Product

@{
    ViewBag.Title = "AddProduct";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<br />
<h2>Adding a Product</h2>
<br />
<form class="form-group" method="post">
    <label>Product Name</label>
    @Html.TextBoxFor(x => x.ProductName, new { @class = "form-control" })

    <label>Brand Name</label>
    @Html.TextBoxFor(x => x.Brand, new { @class = "form-control" })

    <label>Stock</label>
    @Html.TextBoxFor(x => x.Stock, new { @class = "form-control" })

    <label>Purchase Price</label>
    @Html.TextBoxFor(x => x.PurchasePrice, new { @class = "form-control" })

    <label>Selling Price</label>
    @Html.TextBoxFor(x => x.SellPrice, new { @class = "form-control" })

    <label>Category</label>
    @Html.DropDownListFor(x=>x.Categoryid, (List<SelectListItem>)ViewBag.dgr1, new {@class="form-control"})
    @*@Html.TextBoxFor(x => x.Categoryid, new { @class = "form-control" })*@

    <label>Product Image</label>
    @Html.TextBoxFor(x => x.ProductImage, new { @class = "form-control" })

    <label>Status</label>
    @Html.TextBoxFor(x => x.Status, new { @class = "form-control" })

    <br />
    <button class="btn btn-primary">Add</button>

</form>