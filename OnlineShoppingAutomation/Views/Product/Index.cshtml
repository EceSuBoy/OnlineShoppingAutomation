@using OnlineShoppingAutomation.Models.Classes
@using PagedList
@using PagedList.Mvc
@model IPagedList<Product>

<style>
    .custom-pagination .page-link {
        border-radius: 50%;
        margin: 0 5px;
        border: none;
        color: #555;
        background-color: #f8f9fa;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
    }

        .custom-pagination .page-link:hover {
            transform: scale(1.15);
            background-color: #6c63ff;
            color: #fff;
            box-shadow: 0 4px 12px rgba(108,99,255,0.4);
        }

    .custom-pagination .page-item.active .page-link {
        background-color: #6c63ff;
        color: #fff;
        box-shadow: 0 4px 12px rgba(108,99,255,0.4);
        transform: scale(1.15);
    }

    .custom-pagination .page-item.disabled .page-link {
        background-color: #e9ecef;
        color: #aaa;
        box-shadow: none;
    }

    .custom-pagination {
    opacity: 0;
    transform: translateY(10px);
    animation: fadeInUp 0.4s ease forwards;
}

@@keyframes fadeInUp {
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

</style>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="table-responsive">
    <table id="example" class="table table-striped table-bordered dt-responsive nowrap" style="width:100%">
        <thead>
            <tr>
                <th>ID</th>
                <th>Product</th>
                <th>Brand</th>
                <th>Stock</th>
                <th>Purchase Price</th>
                <th>Selling Price</th>
                <th>Category</th>
                <th>Image</th>
                <th>Delete</th>
                <th>Update</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.ProductId</td>
                    <td>@u.ProductName</td>
                    <td>@u.Brand</td>
                    <td>@u.Stock</td>
                    <td>@u.PurchasePrice</td>
                    <td>@u.SellPrice</td>
                    <td>@u.Category.CategoryName</td>
                    <td>
                        @if (!string.IsNullOrEmpty(u.ProductImage))
                        {
                            <img src="@u.ProductImage" style="width:60px;height:auto;" />
                        }
                    </td>
                    <td>
                        <a href="/Product/DeleteProduct/@u.ProductId" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                    <td>
                        <a href="/Product/UpdateProduct/@u.ProductId" class="btn btn-warning btn-sm">Update</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<br />
<!-- Your custom animated pagination -->
<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center custom-pagination">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber - 1 })" tabindex="-1" aria-disabled="@(Model.HasPreviousPage ? "false" : "true")">&laquo;</a>
        </li>

        @for (int i = 1; i <= Model.PageCount; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
            </li>
        }

        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber + 1 })">&raquo;</a>
        </li>
    </ul>
</nav>

<a href="/Product/AddProduct/" class="btn btn-info">New Product</a>
