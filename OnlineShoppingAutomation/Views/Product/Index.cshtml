@using OnlineShoppingAutomation.Models.Classes
@model List<Product>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <th>Product</th>
        <th>Brand</th>
        <th>Stock</th>
        <th>Purchase Price</th>
        <th>Selling Price</th>
        <th>Category</th>
        <th>Image</th>
        <th>Delete</th>
        <th>Update</th>

    </tr>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.ProductId</td>
            <td>@u.ProductName</td>
            <td>@u.Brand</td>
            <td>@u.Stock</td>
            <td>@u.PurchasePrice</td>
            <td>@u.SellPrice</td>
            <td>@u.Category.CategoryName</td>
            <td>@u.ProductImage</td>
            <td>
                <a href="/Product/DeleteProduct/@u.ProductId" class="btn btn-danger">Delete</a>
            </td>

            <td>
                <a href="/Product/UpdateProduct/@u.ProductId" class="btn btn-warning">Update</a>
            </td>
        </tr>
    }

</table>
<a href="/Product/AddProduct/" class="btn btn-info">New Product</a>
