@using OnlineShoppingAutomation.Models.Classes
@model List<Category>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<table class="table table-bordered" style="margin-top:20px">
    <tr>
        <th>ID</th>
        <th>Category Name</th>
        <th>Delete</th>
        <th>Update</th>
    </tr>

    @foreach (var k in Model)
    {
        <tr>
            <td>@k.CategoryId</td>
            <td>@k.CategoryName</td>

            <td><a href="/Category/DeleteCategory/@k.CategoryId/" method="post" class="btn btn-danger">Delete</a></td>
            <td><a href="/Category/UpdateCategory/@k.CategoryId/" method="post" class="btn btn-warning">Update</a></td>
        </tr>
    }
</table>
<a href="/Category/AddCategory/" class="btn btn-primary">Add Category</a>