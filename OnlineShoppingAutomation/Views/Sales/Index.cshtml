@using OnlineShoppingAutomation.Models.Classes
@model List<SalesLog>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<table id="tbl1" class="table table-bordered" style="margin-top:20px">
    <thead>
        <tr>
            <th>ID</th>
            <th>Product</th>
            <th>Seller</th>
            <th>Employee</th>
            <th>Amount</th>
            <th>Price</th>
            <th>Sum</th>
            <th>Date</th>
            <th>Update</th>
            <th>Details</th>
        </tr>
    </thead>
    @foreach (var k in Model)
    {
        <tr>
            <td>@k.SalesId</td>
            <td>@k.Product.ProductName</td>
            <td>@k.Seller.SellerName @k.Seller.SellerSurname</td>
            <td>@k.Employee.EmployeeName @k.Employee.EmployeeSurname</td>
            <td>@k.Amount</td>
            <td>@k.Price</td>
            <td>@k.TotalSum</td>
            <td>@k.Date</td>

            <td><a href="/Sales/UpdateSales/@k.SalesId/" method="post" class="btn btn-warning">Update</a></td>
            <td><a href="/Sales/DetailSales/@k.SalesId/" method="post" class="btn btn-default" style="background-color:lightcoral; color:white;">Details</a></td>

        </tr>
    }
</table>
<a href="/Sales/AddSales/" class="btn btn-info">Make a New Sale</a>


<link href="~/Content/bootstrap.css" rel="stylesheet" />

<script src="//ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js"></script>




<link href="https://cdn.datatables.net/1.10.15/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/responsive/2.1.1/css/responsive.bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.datatables.net/1.10.15/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.10.15/js/dataTables.bootstrap4.min.js "></script>

<script>
    $('#tbl1').dataTable({});
</script>
