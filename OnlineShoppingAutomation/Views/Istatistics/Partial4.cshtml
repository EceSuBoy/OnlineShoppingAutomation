@model IEnumerable<OnlineShoppingAutomation.Models.Classes.GroupClass3>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Product Brand Table</h3>
    </div>
    <!-- /.card-header -->
    <div class="card-body p-0">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th style="width: 10px">#</th>
                    <th>Brand</th>
                    <th>Progress Bar</th>
                    <th style="width: 40px">Sum</th>
                </tr>
            </thead>
            <tbody>
                @{ int itemno = 0;}

                @foreach (var x in Model)
                {
                    <tr>
                        <td>@{itemno++;} @itemno</td>
                        <td>@x.brand</td>
                        <td>
                            @if (x.count >= 1 && x.count<=2)
                            {
                                <div class="progress progress-xs">
                                    <div class="progress-bar progress-bar-danger" style="width: 30%"></div>
                                </div>
                            }

                            @if (x.count >= 3 && x.count <= 4)
                            {
                                <div class="progress progress-xs">
                                    <div class="progress-bar bg-warning" style="width: 75%"></div>
                                </div>
                            }
                            @if (x.count>= 5)
                            {
                                <div class="progress progress-xs">
                                    <div class="progress-bar bg-success" style="width: 90%"></div>
                                </div>
                            }
                        </td>
                        <td>
                            @if (x.count >= 1 && x.count <= 2)
                            {
                                <span class="badge bg-danger">@x.count</span>
                            }
                            @if (x.count >= 3 && x.count <= 4)
                            {
                                <span class="badge bg-warning">@x.count</span>
                            }
                            @if (x.count >= 5)
                            {
                                <span class="badge bg-success">@x.count</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <!-- /.card-body -->
</div>
