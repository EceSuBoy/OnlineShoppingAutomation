@using OnlineShoppingAutomation.Models.Classes
@model List<Employee>

@{
    ViewBag.Title = "DetailDepartment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h2>Department Detail Page</h2>
<br />
<ol class="breadcrumb" mb-4>
    <li class="breadcrumb-item active">Department Name: @ViewBag.d</li>
</ol>

<table class="table table-hover">
    <tr>
        <th>Employee ID</th>
        <th>Employee Name</th>
        <th>Employee Surname</th>
        <th>Employee Image</th>
        <th>Sales</th>
    </tr>
    @foreach (var x in Model)
    {
        <tr>
            <td>@x.EmployeeId</td>
            <td>@x.EmployeeName</td>
            <td>@x.EmployeeSurname</td>
            <td>@x.EmployeeImage</td>
            <td><a href="/Department/EmployeeSaleDepartment/@x.EmployeeId/" class="btn btn-default" style="background-color:navajowhite">Sales</a></td>
        </tr>
    }
</table>

