@using OnlineShoppingAutomation.Models.Classes
@model List<Employee>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<table class="table table-bordered" style="margin-top:20px">
    <tr>
        <th>ID</th>
        <th>Employee Name</th>
        <th>Employee Surname</th>
        <th>Image</th>
        <th>Department</th>
        <th>Update</th>
        <th>Sales</th>
    </tr>

    @foreach (var k in Model)
    {
        <tr>
            <td>@k.EmployeeId</td>
            <td>@k.EmployeeName</td>
            <td>@k.EmployeeSurname</td>
            <td>@k.EmployeeName</td>
            <td>@k.Department.DepartmentName</td>

            <td><a href="/Employee/UpdateEmployee/@k.EmployeeId/" method="post" class="btn btn-warning">Update</a></td>
            <td><a href="/Department/EmployeeSaleDepartment/@k.EmployeeId/" method="post" class="btn btn-default" style="background-color:lightcoral; color:white;">Details</a></td>

        </tr>
    }
</table>
<a href="/Employee/EmployeeAdd/" class="btn btn-info">Add Employee</a>



